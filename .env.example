# Copia este fichero a .env y cambia los valores. .env no se sube al repositorio.

# Contraseña de PostgreSQL (la usa también el backend).
POSTGRES_PASSWORD=cambia-esta-contraseña

# Secreto para firmar los JWT (HS256): 32 caracteres o más.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET=

# Carga los usuarios y movimientos de demostración al arrancar con la base vacía.
DEMO_DATA=true

# Ponlo a true si sirves la web por HTTPS (la cookie de sesión solo viajará cifrada).
REFRESH_COOKIE_SECURE=false
